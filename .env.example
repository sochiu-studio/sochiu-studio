# Neon Postgres (`neon init` / `neon env pull` writes these to .env.local)
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Cloudflare R2 (S3-compatible) - images for the Media collection
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL of the bucket (r2.dev or custom domain), no trailing slash
R2_PUBLIC_URL=

# Lets scripts (the WordPress import) refresh the cached pages: POST /api/revalidate
REVALIDATE_SECRET=
